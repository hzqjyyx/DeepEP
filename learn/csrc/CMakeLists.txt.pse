--------------------------------
CMakeLists.txt (构建配置)
来源: csrc/CMakeLists.txt
--------------------------------

【项目】
    deep_ep
    语言: CUDA, C++
    用途: PyTorch扩展的调试构建配置（生产构建使用setup.py）

【编译选项】
    CMAKE_C_FLAGS: -O3 -fPIC
    CMAKE_CXX_FLAGS: -O3 -fPIC
    CUDA_NVCC_FLAGS:
        - -DENABLE_FAST_DEBUG
        - -O3
        - --ptxas-options=--verbose,--register-usage-level=10,--warn-on-local-memory-usage
    CUDA_SEPARABLE_COMPILATION: ON
    USE_SYSTEM_NVTX: on

【架构】
    CUDA_ARCH_LIST: "9.0"    # 目标SM架构（默认H800/Hopper）
    TORCH_CUDA_ARCH_LIST: ${CUDA_ARCH_LIST}

【依赖】
    CUDAToolkit    # CUDA头文件和库
    pybind11       # Python绑定
    Torch          # PyTorch
    NVSHMEM        # 多节点通信（在NVSHMEM_ROOT_DIR/lib/cmake/nvshmem查找）

【库别名】
    nvshmem -> nvshmem::nvshmem
    nvshmem_host -> nvshmem::nvshmem_host
    nvshmem_device -> nvshmem::nvshmem_device

【标准】
    CMAKE_CXX_STANDARD: 17
    CMAKE_CUDA_STANDARD: 17

【包含路径】
    ${CUDA_TOOLKIT_ROOT_DIR}/include
    ${TORCH_INCLUDE_DIRS}
    ${PYTHON_INCLUDE_DIRS}
    ${NVSHMEM_INCLUDE_DIR}

【链接路径】
    ${TORCH_INSTALL_PREFIX}/lib
    ${CUDA_TOOLKIT_ROOT_DIR}/lib
    ${NVSHMEM_LIB_DIR}

【构建目标】
    子目录: kernels/    # CUDA kernel实现，生成EP_CUDA_LIBRARIES

    pybind11_add_module(deep_ep_cpp, deep_ep.cpp)
        链接: ${EP_CUDA_LIBRARIES}, ${TORCH_LIBRARIES}, torch_python

【备注】
    - 这个CMake仅用于调试，生产环境使用setup.py构建
    - EP_CUDA_LIBRARIES由kernels/CMakeLists.txt定义（未包含在此文件）

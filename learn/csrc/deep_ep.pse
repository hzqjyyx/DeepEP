--------------------------------
Buffer::Buffer (构造函数)
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    Buffer(
        rank: int,
        num_ranks: int,
        num_nvl_bytes: int64,
        num_rdma_bytes: int64,
        low_latency_mode: bool,
        explicitly_destroy: bool,
        enable_shrink: bool,
        use_fabric: bool
    )

【算法】
    # 初始化基本信息
    this.rank = rank
    this.num_ranks = num_ranks
    this.num_nvl_bytes = num_nvl_bytes
    this.num_rdma_bytes = num_rdma_bytes
    this.low_latency_mode = low_latency_mode
    this.explicitly_destroy = explicitly_destroy
    this.enable_shrink = enable_shrink
    
    # 获取设备信息
    this.device_id = at::cuda::current_device()
    cudaDeviceGetAttribute(&this.num_device_sms, cudaDevAttrMultiProcessorCount, this.device_id)
    
    # 初始化共享内存分配器
    this.shared_memory_allocator = SharedMemoryAllocator(use_fabric)
    
    # 创建通信流
    this.comm_stream = at::cuda::getStreamFromPool(true, this.device_id)
    
    # 分配 NVLink buffer (用于 intranode 通信)
    if num_nvl_bytes > 0:
        for i in range(NUM_MAX_NVL_PEERS):
            shared_memory_allocator.malloc(&buffer_ptrs[i], num_nvl_bytes)
        
        cudaMalloc(&buffer_ptrs_gpu, NUM_MAX_NVL_PEERS * sizeof(void*))
        cudaMemcpy(buffer_ptrs_gpu, buffer_ptrs, ...)
    
    # 分配 RDMA buffer (用于 internode 通信)
    if num_rdma_bytes > 0:
        nvshmem_malloc(&rdma_buffer_ptr, num_rdma_bytes)
    
    # 分配 shrink mode 相关 buffer
    if enable_shrink:
        cudaMallocHost(&mask_buffer_ptr, NUM_MAX_NVL_PEERS * sizeof(int))
        cudaMallocHost(&sync_buffer_ptr, NUM_MAX_NVL_PEERS * sizeof(int))
        memset(mask_buffer_ptr, 0, ...)
        memset(sync_buffer_ptr, 0, ...)
    
    # 分配 barrier 信号 buffer (用于同步)
    for i in range(NUM_MAX_NVL_PEERS):
        shared_memory_allocator.malloc(&barrier_signal_ptrs[i], sizeof(int))
        cudaMemset(barrier_signal_ptrs[i], 0, sizeof(int))
    
    cudaMalloc(&barrier_signal_ptrs_gpu, NUM_MAX_NVL_PEERS * sizeof(int*))
    cudaMemcpy(barrier_signal_ptrs_gpu, barrier_signal_ptrs, ...)
    
    # 分配 workspace (临时工作空间)
    cudaMalloc(&workspace, RUNTIME_WORKSPACE_SIZE)
    
    # 分配 MoE 接收计数器 (host-side, pinned memory)
    cudaMallocHost(&moe_recv_counter, NUM_MAX_NVL_PEERS * sizeof(int))
    cudaHostGetDevicePointer(&moe_recv_counter_mapped, moe_recv_counter, 0)
    memset(moe_recv_counter, 0, ...)
    
    # 分配 expert-level MoE 接收计数器
    cudaMallocHost(&moe_recv_expert_counter, NUM_MAX_NVL_PEERS * NUM_MAX_EXPERTS * sizeof(int))
    cudaHostGetDevicePointer(&moe_recv_expert_counter_mapped, moe_recv_expert_counter, 0)
    memset(moe_recv_expert_counter, 0, ...)
    
    # 分配 RDMA-level MoE 接收计数器
    cudaMallocHost(&moe_recv_rdma_counter, NUM_MAX_RDMA_RANKS * sizeof(int))
    cudaHostGetDevicePointer(&moe_recv_rdma_counter_mapped, moe_recv_rdma_counter, 0)
    memset(moe_recv_rdma_counter, 0, ...)

【备注】
    - 构造函数分配所有通信所需的 buffer，但此时 buffer 尚未可用 (available=false)
    - 需要调用 sync() 完成 IPC handle 交换和 NVSHMEM 初始化后才可用
    - NUM_MAX_NVL_PEERS=8, NUM_MAX_EXPERTS, NUM_MAX_RDMA_RANKS 等常量在 kernels/configs.cuh 中定义

--------------------------------
Buffer::~Buffer (析构函数)
来源: csrc/deep_ep.cpp
--------------------------------

【算法】
    if not explicitly_destroy:
        destroy()
    
    # 释放 NVLink buffers
    if buffer_ptrs_gpu != nullptr:
        cudaFree(buffer_ptrs_gpu)
        for i in range(NUM_MAX_NVL_PEERS):
            if buffer_ptrs[i] != nullptr:
                shared_memory_allocator.free(buffer_ptrs[i])
    
    # 释放 RDMA buffer
    if rdma_buffer_ptr != nullptr:
        nvshmem_free(rdma_buffer_ptr)
    
    # 释放 shrink mode buffers
    if mask_buffer_ptr != nullptr:
        cudaFreeHost(mask_buffer_ptr)
    if sync_buffer_ptr != nullptr:
        cudaFreeHost(sync_buffer_ptr)
    
    # 释放 barrier signals
    if barrier_signal_ptrs_gpu != nullptr:
        cudaFree(barrier_signal_ptrs_gpu)
        for i in range(NUM_MAX_NVL_PEERS):
            if barrier_signal_ptrs[i] != nullptr:
                shared_memory_allocator.free(barrier_signal_ptrs[i])
    
    # 释放 workspace
    if workspace != nullptr:
        cudaFree(workspace)
    
    # 释放 MoE 计数器
    if moe_recv_counter != nullptr:
        cudaFreeHost(moe_recv_counter)
    if moe_recv_expert_counter != nullptr:
        cudaFreeHost(moe_recv_expert_counter)
    if moe_recv_rdma_counter != nullptr:
        cudaFreeHost(moe_recv_rdma_counter)


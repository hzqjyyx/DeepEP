Buffer::get_comm_stream
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    get_comm_stream() -> torch.Stream

【算法】
    stream_id = comm_stream.id()
    stream_device = comm_stream.device_index()
    
    return py::cast(c10::cuda::CUDAStream::unpack3(
        stream_id,
        stream_device,
        c10::DeviceType::CUDA
    ))

【备注】
    - 返回 Python 侧的 torch.cuda.Stream 对象

--------------------------------
Buffer::sync
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    sync(
        device_ids: List[int],
        all_gathered_handles: List[Optional[bytearray]],
        root_unique_id_opt: Optional[bytearray]
    )

【算法】
    assert not available and not destroyed
    
    # 交换 NVLink IPC handles
    if num_nvl_bytes > 0:
        for i in range(num_ranks):
            if i == rank:
                continue
            
            if all_gathered_handles[i] is not None:
                memcpy(&ipc_handles[i], all_gathered_handles[i].data(), HANDLE_SIZE)
                shared_memory_allocator.open_mem_handle(&buffer_ptrs[i], &ipc_handles[i])
        
        cudaMemcpy(buffer_ptrs_gpu, buffer_ptrs, ...)
    
    # 初始化 NVSHMEM
    if num_rdma_bytes > 0:
        assert root_unique_id_opt is not None
        
        memcpy(&root_unique_id, root_unique_id_opt.data(), sizeof(nvshmemx_uniqueid_t))
        
        nvshmem_init(
            rank, num_ranks,
            buffer_ptrs_gpu,
            barrier_signal_ptrs_gpu,
            workspace,
            &root_unique_id,
            &rdma_rank,
            &num_rdma_ranks,
            &nvl_rank,
            &num_nvl_ranks
        )
    else:
        rdma_rank = -1
        num_rdma_ranks = 0
        nvl_rank = rank
        num_nvl_ranks = num_ranks
    
    this.available = true

【依赖】
    nvshmem_init    # kernels/runtime.cu 中定义

【备注】
    - 必须在所有 rank 上同时调用
    - all_gathered_handles: 每个 rank 的 IPC handle (通过 torch.distributed 收集)
    - root_unique_id_opt: NVSHMEM unique ID (只在有 RDMA 时提供)
    - 完成后 buffer 可用 (available=true)

--------------------------------
Buffer::destroy
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    destroy()

【算法】
    if destroyed:
        return
    
    this.destroyed = true
    
    if not available:
        return
    
    # 关闭其他 rank 的 IPC handles
    if num_nvl_bytes > 0:
        for i in range(num_ranks):
            if i != rank and buffer_ptrs[i] != nullptr:
                shared_memory_allocator.close_mem_handle(buffer_ptrs[i])
    
    # 销毁 NVSHMEM
    if num_rdma_bytes > 0:
        nvshmem_finalize()

【依赖】
    nvshmem_finalize    # kernels/runtime.cu 中定义

【备注】
    - 只在 explicitly_destroy=true 时由用户手动调用
    - 否则由析构函数自动调用

--------------------------------
Buffer::get_dispatch_layout
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    @host→device
    get_dispatch_layout(
        topk_idx: Tensor[num_tokens, topk, int],
        num_experts: int,
        previous_event: Optional[EventHandle],
        async: bool,
        allocate_on_comm_stream: bool
    ) -> (
        is_token_in_rank: Tensor[num_tokens, topk, bool],
        num_tokens_per_rank: Optional[Tensor[num_ranks, int]],
        num_tokens_per_expert: Tensor[num_experts, int],
        is_expert_in_rank: Tensor[num_experts, bool],
        event: Optional[EventHandle]
    )

【算法】
    assert available and not destroyed
    
    stream = comm_stream if allocate_on_comm_stream else at::cuda::getCurrentCUDAStream()
    
    if previous_event is not None:
        cudaStreamWaitEvent(stream, previous_event)
    
    # 创建输出 tensors
    is_token_in_rank = torch::empty({num_tokens, topk}, torch::kBool, device)
    num_tokens_per_rank = torch::empty({num_ranks}, torch::kInt32, device) if not low_latency_mode else None
    num_tokens_per_expert = torch::empty({num_experts}, torch::kInt32, device)
    is_expert_in_rank = torch::empty({num_experts}, torch::kBool, device)
    
    # 调用 layout kernel
    get_dispatch_layout_kernel(
        is_token_in_rank,
        num_tokens_per_rank,
        num_tokens_per_expert,
        is_expert_in_rank,
        topk_idx,
        num_experts,
        rank,
        num_ranks,
        stream
    )
    
    event = create_event() if async else None
    
    return (is_token_in_rank, num_tokens_per_rank, num_tokens_per_expert, is_expert_in_rank, event)

【依赖】
    get_dispatch_layout_kernel    # kernels/layout.cu

【备注】
    - 计算 token 到 expert/rank 的分配关系
    - low_latency_mode 下不需要 num_tokens_per_rank

--------------------------------
Buffer::intranode_dispatch
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    @host→device
    intranode_dispatch(
        x: Tensor[num_tokens, hidden],
        x_scales: Optional[Tensor[num_tokens, 1]],
        topk_idx: Optional[Tensor[num_tokens, topk, int]],
        topk_weights: Optional[Tensor[num_tokens, topk]],
        num_tokens_per_rank: Optional[Tensor[num_ranks, int]],
        is_token_in_rank: Tensor[num_tokens, topk, bool],
        num_tokens_per_expert: Optional[Tensor[num_experts, int]],
        cached_num_recv_tokens: int,
        cached_rank_prefix_matrix: Optional[Tensor],
        cached_channel_prefix_matrix: Optional[Tensor],
        expert_alignment: int,
        num_worst_tokens: int,
        config: Config,
        previous_event: Optional[EventHandle],
        async: bool,
        allocate_on_comm_stream: bool
    ) -> (
        recv_x: Tensor[num_recv_tokens, hidden],
        recv_x_scales: Optional[Tensor[num_recv_tokens, 1]],
        recv_topk_weights: Optional[Tensor[num_recv_tokens]],
        recv_idx: Optional[Tensor[num_recv_tokens, int]],
        num_recv_tokens_per_expert: List[int],
        rank_prefix_matrix: Tensor,
        channel_prefix_matrix: Tensor,
        src_idx: Tensor,
        send_head: Tensor,
        send_tail: Tensor,
        event: Optional[EventHandle]
    )

【算法】
    assert available and not destroyed
    assert num_nvl_ranks > 1
    
    stream = comm_stream if allocate_on_comm_stream else at::cuda::getCurrentCUDAStream()
    
    if previous_event is not None:
        cudaStreamWaitEvent(stream, previous_event)
    
    # Step 1: 准备 config
    dispatch_config = prepare_intranode_dispatch_config(x, config)
    
    # Step 2: 分配输出 buffer
    if cached_num_recv_tokens > 0:
        num_recv_tokens = cached_num_recv_tokens
        rank_prefix_matrix = cached_rank_prefix_matrix
        channel_prefix_matrix = cached_channel_prefix_matrix
    else:
        (num_recv_tokens, rank_prefix_matrix, channel_prefix_matrix) = 
            allocate_intranode_dispatch_buffers(
                num_tokens_per_rank,
                num_experts,
                expert_alignment,
                num_worst_tokens,
                stream
            )
    
    recv_x = torch::empty({num_recv_tokens, hidden}, x.dtype, device)
    recv_x_scales = torch::empty({num_recv_tokens, 1}, torch::kFloat32, device) if x_scales else None
    recv_topk_weights = torch::empty({num_recv_tokens}, topk_weights.dtype, device) if topk_weights else None
    recv_idx = torch::empty({num_recv_tokens}, topk_idx.dtype, device) if topk_idx else None
    
    src_idx = torch::empty({num_recv_tokens}, torch::kInt32, device)
    send_head = torch::empty({num_nvl_ranks, NUM_MAX_CHANNELS_PER_PEER}, torch::kInt32, device)
    send_tail = torch::empty({num_nvl_ranks, NUM_MAX_CHANNELS_PER_PEER}, torch::kInt32, device)
    
    # Step 3: 调用 dispatch kernel
    intranode_dispatch_kernel(
        recv_x, recv_x_scales, recv_topk_weights, recv_idx,
        src_idx, send_head, send_tail,
        x, x_scales, topk_idx, topk_weights,
        is_token_in_rank,
        rank_prefix_matrix, channel_prefix_matrix,
        num_experts,
        buffer_ptrs_gpu,
        barrier_signal_ptrs_gpu,
        moe_recv_counter_mapped,
        dispatch_config,
        stream
    )
    
    # Step 4: 获取每个 expert 收到的 token 数
    num_recv_tokens_per_expert = []
    if num_tokens_per_expert is not None:
        num_recv_tokens_per_expert = compute_num_recv_tokens_per_expert(
            num_tokens_per_expert,
            stream
        )
    
    event = create_event() if async else None
    
    return (recv_x, recv_x_scales, recv_topk_weights, recv_idx,
            num_recv_tokens_per_expert,
            rank_prefix_matrix, channel_prefix_matrix,
            src_idx, send_head, send_tail,
            event)

【依赖】
    intranode_dispatch_kernel    # kernels/intranode.cu

【备注】
    - NVLink-based all-to-all dispatch
    - buffer_ptrs_gpu: 指向所有 rank 的 NVLink buffer 指针数组
    - moe_recv_counter_mapped: host-side 计数器，GPU 写入接收的 token 数
    - cached_* 参数用于 CUDA Graph 模式

--------------------------------
Buffer::intranode_combine
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    @host→device
    intranode_combine(
        x: Tensor[num_tokens, hidden],
        topk_weights: Optional[Tensor[num_tokens]],
        bias_0: Optional[Tensor[hidden]],
        bias_1: Optional[Tensor[hidden]],
        src_idx: Tensor[num_tokens, int],
        rank_prefix_matrix: Tensor,
        channel_prefix_matrix: Tensor,
        send_head: Tensor,
        config: Config,
        previous_event: Optional[EventHandle],
        async: bool,
        allocate_on_comm_stream: bool
    ) -> (
        recv_x: Tensor[orig_num_tokens, hidden],
        recv_x_scales: Optional[Tensor[orig_num_tokens, 1]],
        event: Optional[EventHandle]
    )

【算法】
    assert available and not destroyed
    assert num_nvl_ranks > 1
    
    stream = comm_stream if allocate_on_comm_stream else at::cuda::getCurrentCUDAStream()
    
    if previous_event is not None:
        cudaStreamWaitEvent(stream, previous_event)
    
    # Step 1: 准备 config
    combine_config = prepare_intranode_combine_config(x, config)
    
    # Step 2: 计算原始 token 数 (combine 前的 token 数)
    orig_num_tokens = compute_orig_num_tokens(rank_prefix_matrix, stream)
    
    # Step 3: 分配输出 buffer
    recv_x = torch::empty({orig_num_tokens, hidden}, x.dtype, device)
    recv_x_scales = torch::empty({orig_num_tokens, 1}, torch::kFloat32, device) if has_fp8(x) else None
    
    # Step 4: 调用 combine kernel
    intranode_combine_kernel(
        recv_x, recv_x_scales,
        x, topk_weights,
        bias_0, bias_1,
        src_idx,
        rank_prefix_matrix, channel_prefix_matrix,
        send_head,
        buffer_ptrs_gpu,
        barrier_signal_ptrs_gpu,
        combine_config,
        stream
    )
    
    event = create_event() if async else None
    
    return (recv_x, recv_x_scales, event)

【依赖】
    intranode_combine_kernel    # kernels/intranode.cu

【备注】
    - NVLink-based all-to-all combine
    - 将分散在各 rank 上的 expert 输出聚合回原始 token 顺序

--------------------------------
Buffer::internode_dispatch
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    @host→device
    internode_dispatch(
        x: Tensor[num_tokens, hidden],
        x_scales: Optional[Tensor[num_tokens, 1]],
        topk_idx: Optional[Tensor[num_tokens, topk, int]],
        topk_weights: Optional[Tensor[num_tokens, topk]],
        num_tokens_per_rank: Optional[Tensor[num_ranks, int]],
        num_tokens_per_rdma_rank: Optional[Tensor[num_rdma_ranks, int]],
        is_token_in_rank: Tensor[num_tokens, topk, bool],
        num_tokens_per_expert: Optional[Tensor[num_experts, int]],
        cached_num_recv_tokens: int,
        cached_num_rdma_recv_tokens: int,
        cached_rdma_channel_prefix_matrix: Optional[Tensor],
        cached_recv_rdma_rank_prefix_sum: Optional[Tensor],
        cached_gbl_channel_prefix_matrix: Optional[Tensor],
        cached_recv_gbl_rank_prefix_sum: Optional[Tensor],
        expert_alignment: int,
        num_worst_tokens: int,
        config: Config,
        previous_event: Optional[EventHandle],
        async: bool,
        allocate_on_comm_stream: bool
    ) -> (
        recv_x: Tensor[num_recv_tokens, hidden],
        recv_x_scales: Optional[Tensor[num_recv_tokens, 1]],
        recv_topk_weights: Optional[Tensor[num_recv_tokens]],
        recv_idx: Optional[Tensor[num_recv_tokens, int]],
        num_recv_tokens_per_expert: List[int],
        rdma_channel_prefix_matrix: Tensor,
        rdma_rank_prefix_sum: Tensor,
        recv_rdma_rank_prefix_sum: Optional[Tensor],
        gbl_channel_prefix_matrix: Tensor,
        recv_gbl_rank_prefix_sum: Optional[Tensor],
        src_meta: Tensor,
        combined_rdma_head: Optional[Tensor],
        combined_nvl_head: Optional[Tensor],
        is_combined_token_in_rank: Optional[Tensor],
        event: Optional[EventHandle]
    )

【算法】
    assert available and not destroyed
    assert num_rdma_ranks > 1
    
    stream = comm_stream if allocate_on_comm_stream else at::cuda::getCurrentCUDAStream()
    
    if previous_event is not None:
        cudaStreamWaitEvent(stream, previous_event)
    
    # Step 1: 准备 config
    dispatch_config = prepare_internode_dispatch_config(x, config)
    
    # Step 2: 分配输出 buffer (根据是否有 cached 值)
    if cached_num_recv_tokens > 0:
        num_recv_tokens = cached_num_recv_tokens
        num_rdma_recv_tokens = cached_num_rdma_recv_tokens
        rdma_channel_prefix_matrix = cached_rdma_channel_prefix_matrix
        recv_rdma_rank_prefix_sum = cached_recv_rdma_rank_prefix_sum
        gbl_channel_prefix_matrix = cached_gbl_channel_prefix_matrix
        recv_gbl_rank_prefix_sum = cached_recv_gbl_rank_prefix_sum
    else:
        (num_recv_tokens, num_rdma_recv_tokens,
         rdma_channel_prefix_matrix, rdma_rank_prefix_sum,
         recv_rdma_rank_prefix_sum,
         gbl_channel_prefix_matrix,
         recv_gbl_rank_prefix_sum) = 
            allocate_internode_dispatch_buffers(
                num_tokens_per_rank,
                num_tokens_per_rdma_rank,
                num_experts,
                expert_alignment,
                num_worst_tokens,
                stream
            )
    
    recv_x = torch::empty({num_recv_tokens, hidden}, x.dtype, device)
    recv_x_scales = torch::empty({num_recv_tokens, 1}, torch::kFloat32, device) if x_scales else None
    recv_topk_weights = torch::empty({num_recv_tokens}, topk_weights.dtype, device) if topk_weights else None
    recv_idx = torch::empty({num_recv_tokens}, topk_idx.dtype, device) if topk_idx else None
    
    src_meta = torch::empty({num_recv_tokens, 2}, torch::kInt32, device)
    combined_rdma_head = torch::empty({...}, torch::kInt32, device) if num_rdma_ranks > 1 else None
    combined_nvl_head = torch::empty({...}, torch::kInt32, device) if num_nvl_ranks > 1 else None
    is_combined_token_in_rank = torch::empty({...}, torch::kBool, device) if needed else None
    
    # Step 3: 调用 dispatch kernel
    internode_dispatch_kernel(
        recv_x, recv_x_scales, recv_topk_weights, recv_idx,
        src_meta, combined_rdma_head, combined_nvl_head,
        is_combined_token_in_rank,
        x, x_scales, topk_idx, topk_weights,
        is_token_in_rank,
        rdma_channel_prefix_matrix, rdma_rank_prefix_sum,
        gbl_channel_prefix_matrix,
        num_experts,
        rdma_buffer_ptr,
        buffer_ptrs_gpu,
        barrier_signal_ptrs_gpu,
        moe_recv_counter_mapped,
        moe_recv_rdma_counter_mapped,
        dispatch_config,
        stream
    )
    
    # Step 4: 获取每个 expert 收到的 token 数
    num_recv_tokens_per_expert = []
    if num_tokens_per_expert is not None:
        num_recv_tokens_per_expert = compute_num_recv_tokens_per_expert(
            num_tokens_per_expert,
            stream
        )
    
    event = create_event() if async else None
    
    return (recv_x, recv_x_scales, recv_topk_weights, recv_idx,
            num_recv_tokens_per_expert,
            rdma_channel_prefix_matrix, rdma_rank_prefix_sum,
            recv_rdma_rank_prefix_sum,
            gbl_channel_prefix_matrix,
            recv_gbl_rank_prefix_sum,
            src_meta,
            combined_rdma_head, combined_nvl_head,
            is_combined_token_in_rank,
            event)

【依赖】
    internode_dispatch_kernel    # kernels/internode.cu

【备注】
    - RDMA + NVLink 混合的 all-to-all dispatch
    - rdma_buffer_ptr: NVSHMEM 分配的 RDMA buffer
    - 支持跨节点通信

--------------------------------
Buffer::internode_combine
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    @host→device
    internode_combine(
        x: Tensor[num_tokens, hidden],
        topk_weights: Optional[Tensor[num_tokens]],
        bias_0: Optional[Tensor[hidden]],
        bias_1: Optional[Tensor[hidden]],
        src_meta: Tensor[num_tokens, 2, int],
        is_combined_token_in_rank: Tensor[orig_num_tokens, topk, bool],
        rdma_channel_prefix_matrix: Tensor,
        rdma_rank_prefix_sum: Tensor,
        gbl_channel_prefix_matrix: Tensor,
        combined_rdma_head: Tensor,
        combined_nvl_head: Tensor,
        config: Config,
        previous_event: Optional[EventHandle],
        async: bool,
        allocate_on_comm_stream: bool
    ) -> (
        recv_x: Tensor[orig_num_tokens, hidden],
        recv_x_scales: Optional[Tensor[orig_num_tokens, 1]],
        event: Optional[EventHandle]
    )

【算法】
    assert available and not destroyed
    assert num_rdma_ranks > 1
    
    stream = comm_stream if allocate_on_comm_stream else at::cuda::getCurrentCUDAStream()
    
    if previous_event is not None:
        cudaStreamWaitEvent(stream, previous_event)
    
    # Step 1: 准备 config
    combine_config = prepare_internode_combine_config(x, config)
    
    # Step 2: 计算原始 token 数
    orig_num_tokens = compute_orig_num_tokens(is_combined_token_in_rank, stream)
    
    # Step 3: 分配输出 buffer
    recv_x = torch::empty({orig_num_tokens, hidden}, x.dtype, device)
    recv_x_scales = torch::empty({orig_num_tokens, 1}, torch::kFloat32, device) if has_fp8(x) else None
    
    # Step 4: 调用 combine kernel
    internode_combine_kernel(
        recv_x, recv_x_scales,
        x, topk_weights,
        bias_0, bias_1,
        src_meta,
        is_combined_token_in_rank,
        rdma_channel_prefix_matrix, rdma_rank_prefix_sum,
        gbl_channel_prefix_matrix,
        combined_rdma_head, combined_nvl_head,
        rdma_buffer_ptr,
        buffer_ptrs_gpu,
        barrier_signal_ptrs_gpu,
        combine_config,
        stream
    )
    
    event = create_event() if async else None
    
    return (recv_x, recv_x_scales, event)

【依赖】
    internode_combine_kernel    # kernels/internode.cu

【备注】
    - RDMA + NVLink 混合的 all-to-all combine

--------------------------------
Buffer::clean_low_latency_buffer
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    clean_low_latency_buffer(
        num_max_dispatch_tokens_per_rank: int,
        hidden: int,
        num_experts: int
    )

【算法】
    assert available and not destroyed
    assert low_latency_mode
    
    stream = comm_stream
    
    buffer_size = compute_low_latency_buffer_size(
        num_max_dispatch_tokens_per_rank,
        hidden,
        num_experts
    )
    
    # 清空两个 buffer (double buffering)
    for i in [0, 1]:
        cudaMemsetAsync(
            get_low_latency_buffer(i),
            0,
            buffer_size,
            stream
        )
    
    cudaStreamSynchronize(stream)

【备注】
    - Low-latency mode 使用 double buffering
    - 在推理开始前需要清空 buffer

--------------------------------
Buffer::low_latency_dispatch
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    @host→device
    low_latency_dispatch(
        x: Tensor[num_tokens, hidden],
        topk_idx: Tensor[num_tokens, topk, int],
        cumulative_local_expert_recv_stats: Optional[Tensor],
        dispatch_wait_recv_cost_stats: Optional[Tensor],
        num_max_dispatch_tokens_per_rank: int,
        num_experts: int,
        use_fp8: bool,
        round_scale: bool,
        use_ue8m0: bool,
        async: bool,
        return_recv_hook: bool
    ) -> (
        recv_x: Tensor[num_max_recv_tokens, hidden],
        recv_x_scales: Optional[Tensor[num_max_recv_tokens, 1]],
        num_tokens_per_expert: Tensor[num_experts, int],
        recv_tail: Tensor[num_rdma_ranks, num_local_experts, int],
        layout_range: Tensor[num_experts, 2, int],
        event: Optional[EventHandle],
        recv_hook: Optional[Callable]
    )

【算法】
    assert available and not destroyed
    assert low_latency_mode
    
    stream = comm_stream
    
    # Step 1: 切换 buffer (double buffering)
    current_buffer_idx = low_latency_buffer_idx
    low_latency_buffer_idx = 1 - low_latency_buffer_idx
    
    recv_buffer_ptr = get_low_latency_buffer(current_buffer_idx)
    send_buffer_ptr = get_low_latency_buffer(1 - current_buffer_idx)
    
    # Step 2: 分配输出 tensors
    num_max_recv_tokens = num_max_dispatch_tokens_per_rank * num_rdma_ranks
    
    recv_x = wrap_buffer_as_tensor(recv_buffer_ptr, num_max_recv_tokens, hidden, x.dtype)
    recv_x_scales = allocate_scales(num_max_recv_tokens) if use_fp8 else None
    num_tokens_per_expert = torch::empty({num_experts}, torch::kInt32, device)
    recv_tail = torch::empty({num_rdma_ranks, num_local_experts}, torch::kInt32, device)
    layout_range = torch::empty({num_experts, 2}, torch::kInt32, device)
    
    # Step 3: 调用 low-latency dispatch kernel
    low_latency_dispatch_kernel(
        recv_x, recv_x_scales,
        num_tokens_per_expert,
        recv_tail,
        layout_range,
        x, topk_idx,
        send_buffer_ptr,
        recv_buffer_ptr,
        num_max_dispatch_tokens_per_rank,
        num_experts,
        use_fp8, round_scale, use_ue8m0,
        cumulative_local_expert_recv_stats,
        dispatch_wait_recv_cost_stats,
        stream
    )
    
    # Step 4: 创建 recv hook (可选)
    recv_hook = None
    if return_recv_hook:
        recv_hook = create_recv_hook(recv_tail, stream)
    
    event = create_event() if async else None
    
    return (recv_x, recv_x_scales, num_tokens_per_expert, recv_tail, layout_range, event, recv_hook)

【依赖】
    low_latency_dispatch_kernel    # kernels/internode_ll.cu

【备注】
    - Low-latency 推理模式，使用 double buffering 减少延迟
    - recv_hook: Python callable，在计算前调用以等待接收完成
    - 支持 FP8 量化 (e4m3fn, e5m2, ue8m0)

--------------------------------
Buffer::low_latency_combine
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    @host→device
    low_latency_combine(
        x: Tensor[num_tokens, hidden],
        topk_idx: Tensor[orig_num_tokens, topk, int],
        topk_weights: Tensor[orig_num_tokens, topk],
        src_info: Tensor[num_tokens, 2, int],
        layout_range: Tensor[num_experts, 2, int],
        combine_wait_recv_cost_stats: Optional[Tensor],
        num_max_dispatch_tokens_per_rank: int,
        num_experts: int,
        use_logfmt: bool,
        zero_copy: bool,
        async: bool,
        return_recv_hook: bool,
        out: Optional[Tensor] = None
    ) -> (
        recv_x: Tensor[orig_num_tokens, hidden],
        event: Optional[EventHandle],
        recv_hook: Optional[Callable]
    )

【算法】
    assert available and not destroyed
    assert low_latency_mode
    
    stream = comm_stream
    
    # Step 1: 获取当前 buffer
    current_buffer_idx = low_latency_buffer_idx
    recv_buffer_ptr = get_low_latency_buffer(current_buffer_idx)
    
    # Step 2: 分配输出 tensor
    orig_num_tokens = topk_idx.size(0)
    
    if zero_copy:
        # Zero-copy: 直接在 buffer 中写入结果
        recv_x = wrap_buffer_as_tensor(recv_buffer_ptr, orig_num_tokens, hidden, x.dtype)
    else:
        # 正常模式: 分配新 tensor
        if out is not None:
            recv_x = out
        else:
            recv_x = torch::empty({orig_num_tokens, hidden}, x.dtype, device)
    
    # Step 3: 分配 send_tail (用于同步)
    send_tail = torch::empty({num_rdma_ranks, num_local_experts}, torch::kInt32, device)
    
    # Step 4: 调用 low-latency combine kernel
    low_latency_combine_kernel(
        recv_x,
        send_tail,
        x, topk_idx, topk_weights,
        src_info,
        layout_range,
        recv_buffer_ptr,
        num_max_dispatch_tokens_per_rank,
        num_experts,
        use_logfmt,
        combine_wait_recv_cost_stats,
        stream
    )
    
    # Step 5: 创建 recv hook (可选)
    recv_hook = None
    if return_recv_hook:
        recv_hook = create_recv_hook(send_tail, stream)
    
    event = create_event() if async else None
    
    return (recv_x, event, recv_hook)

【依赖】
    low_latency_combine_kernel    # kernels/internode_ll.cu

【备注】
    - use_logfmt: topk_weights 是否使用 log 格式存储
    - zero_copy: 是否直接在通信 buffer 中写入结果

--------------------------------
Buffer::get_next_low_latency_combine_buffer
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    get_next_low_latency_combine_buffer(
        num_max_dispatch_tokens_per_rank: int,
        hidden: int,
        num_experts: int
    ) -> Tensor

【算法】
    assert available and not destroyed
    assert low_latency_mode
    
    next_buffer_idx = 1 - low_latency_buffer_idx
    buffer_ptr = get_low_latency_buffer(next_buffer_idx)
    
    num_max_tokens = compute_max_tokens_for_combine(
        num_max_dispatch_tokens_per_rank,
        num_experts
    )
    
    return wrap_buffer_as_tensor(buffer_ptr, num_max_tokens, hidden, torch::kBFloat16)

【备注】
    - 用于 zero-copy 模式，提前获取下一次 combine 的输出 buffer


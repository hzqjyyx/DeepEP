--------------------------------
Buffer::get_local_buffer_tensor
来源: csrc/deep_ep.cpp
--------------------------------

【签名】
    get_local_buffer_tensor(
        dtype: torch.dtype,
        offset: int64,
        use_rdma_buffer: bool
    ) -> Tensor

【算法】
    if use_rdma_buffer:
        assert this.num_rdma_bytes > 0
        ptr = (char*)rdma_buffer_ptr + offset
        size = num_rdma_bytes - offset
    else:
        assert this.num_nvl_bytes > 0
        ptr = (char*)buffer_ptrs[rank] + offset
        size = num_nvl_bytes - offset
    
    element_size = torch.elementSize(dtype)
    assert size % element_size == 0
    
    return torch::from_blob(
        ptr,
        {size / element_size},
        torch::TensorOptions().dtype(dtype).device(torch::kCUDA, device_id)
    )

【备注】
    - 将 buffer 的一部分包装成 Tensor，zero-copy
    - 用于高级用户直接访问通信 buffer


# deep_ep::internode_ll 低延迟互连通信内核

来源: csrc/kernels/internode_ll.cu

---

## 辅助函数

### is_rank_masked

```
【签名】
    @device
    is_rank_masked<use_warp_sync: bool>(mask_buffer_ptr: int*, rank: int) -> bool

【算法】
    if mask_buffer_ptr == nullptr:
        return false
    
    if use_warp_sync:
        # Warp内同步读取，lane 0广播
        return __shfl_sync(0xffffffff, ld_acquire_global(mask_buffer_ptr + rank), 0) != 0
    else:
        return ld_acquire_global(mask_buffer_ptr + rank) != 0
```

### barrier

```
【签名】
    @device
    barrier<kNumThreads: int>(
        thread_id: int,
        rank: int,
        num_ranks: int,
        mask_buffer_ptr: int*,
        sync_buffer_ptr: int*
    )

【算法】
    # Step 1: Quiet所有QP连接
    qps_per_rank = ibgda_get_state().num_rc_per_pe * ibgda_get_state().num_devices_initialized
    
    parallel_for i in range(qps_per_rank * (num_ranks - 1)):
        dst_rank = (rank + 1 + i / qps_per_rank) % num_ranks
        qp_id = i % qps_per_rank
        nvshmemi_ibgda_quiet(dst_rank, qp_id)
    
    # Step 2: 更新本地计数器
    if thread_id == 0:
        atomicAdd(sync_buffer_ptr + rank, -1)
    __syncthreads()
    
    cnt = sync_buffer_ptr[rank]
    
    # Step 3: 更新远程计数器并等待
    if thread_id < num_ranks and thread_id != rank:
        dst_rank = thread_id
        dst_ptr = reinterpret_cast<uint64_t>(sync_buffer_ptr + rank)
        dst_p2p_ptr = nvshmemi_get_p2p_ptr(dst_ptr, rank, dst_rank)
        
        if not is_rank_masked(mask_buffer_ptr, dst_rank):
            # 写入远程计数器
            if dst_p2p_ptr == 0:
                nvshmemi_ibgda_rma_p(reinterpret_cast<int*>(dst_ptr), cnt, dst_rank, 0)
            else:
                st_release_sys_global(reinterpret_cast<int*>(dst_p2p_ptr), cnt)
            
            # 等待远程更新
            start_time = clock64()
            while ld_acquire_sys_global(sync_buffer_ptr + dst_rank) != cnt and \
                  (clock64() - start_time) <= NUM_TIMEOUT_CYCLES:
                pass
            
            # 超时处理
            if (clock64() - start_time) > NUM_TIMEOUT_CYCLES:
                printf("Warning: DeepEP timeout for barrier, rank %d, dst_rank %d\n", rank, dst_rank)
                if mask_buffer_ptr == nullptr:
                    trap()
                atomicExch(mask_buffer_ptr + dst_rank, 1)
    
    __syncthreads()

【并行模式】
    - QP quiet: 多线程并行
    - 远程更新: thread_id < num_ranks 的线程各自负责一个目标rank
```


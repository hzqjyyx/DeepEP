## 无缓存（No-Allocate）加载/存储

### 加载操作（ld_na_relaxed）

【函数】
    @device
    ld_na_relaxed(ptr: const uint8_t*) -> uint8_t
    ld_na_relaxed(ptr: const uint16_t*) -> uint16_t
    ld_na_relaxed(ptr: const uint32_t*) -> uint32_t
    ld_na_relaxed(ptr: const uint64_t*) -> uint64_t

        用途: L1 无分配的 relaxed 加载（不污染缓存）
        调用: asm("ld.relaxed.gpu.global.L1::no_allocate.bXX %0, [%1];")

### 加载操作（ld_nc_global）

【函数】
    @device
    template<dtype_t>
    ld_nc_global(ptr: const dtype_t*) -> dtype_t

    特化版本:
        uint8_t, int, int64_t, float, int2, int4

        用途: 全局 non-coherent 加载（SASS: LDG.E.NA.[width].CONSTANT）
        调用: asm(LD_NC_FUNC ".dtype %0, [%1];")
        
        配置:
            LD_NC_FUNC = "ld.global.nc.L1::no_allocate.L2::256B"  # 默认（激进）
            LD_NC_FUNC = "ld.volatile.global"                      # DISABLE_AGGRESSIVE_PTX_INSTRS=1

【备注】
    - LD_NC_FUNC 默认使用 L2::256B 缓存提示（Hopper 架构优化）
    - 若平台不支持，编译时设置 DISABLE_AGGRESSIVE_PTX_INSTRS=1

### volatile 加载

【函数】
    @device
    ld_volatile_global(ptr: const int*) -> int
    ld_volatile_global(ptr: const float*) -> float
    ld_volatile_global(ptr: const int64_t*) -> int64_t
    ld_volatile_global(ptr: const uint64_t*) -> int64_t

        用途: volatile 加载（保证每次从全局内存读取）
        调用: asm("ld.volatile.global.dtype %0, [%1];")

### 存储操作（st_na_relaxed）

【函数】
    @device
    st_na_relaxed(ptr: const uint8_t*, val: uint8_t)
    st_na_relaxed(ptr: const uint16_t*, val: uint16_t)
    st_na_relaxed(ptr: const uint32_t*, val: uint32_t)
    st_na_relaxed(ptr: const int*, val: int)
    st_na_relaxed(ptr: const int4*, val: int4)

        用途: L1 无分配的 relaxed 存储
        调用: asm("st.relaxed.gpu.global.L1::no_allocate.bXX [%0], %1;")

### 存储操作（st_na_release）

【函数】
    @device
    st_na_release(ptr: const int*, val: int)
    st_na_release(ptr: const uint32_t*, val: uint32_t)
    st_na_release(ptr: const uint64_t*, val: uint64_t)

        用途: L1 无分配的 release 存储（保证写入对其他线程可见）
        调用: asm("st.release.gpu.global.L1::no_allocate.bXX [%0], %1;")

### 存储操作（st_na_global）

【函数】
    @device
    template<dtype_t>
    st_na_global(ptr: const dtype_t*, value: const dtype_t&)

    特化版本:
        int, int64_t, float, int4

        用途: 全局 no-allocate 存储（SASS: ST.E.NA.[width]）
        调用: asm(ST_NA_FUNC ".dtype [%0], %1;")
        
        配置:
            ST_NA_FUNC = "st.global.L1::no_allocate"  # 默认（激进）
            ST_NA_FUNC = "st.global"                  # DISABLE_AGGRESSIVE_PTX_INSTRS=1


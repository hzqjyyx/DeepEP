## 线程与 Warp 工具

【函数】
    @device
    get_lane_id() -> int
        用途: 获取当前线程在 warp 内的 lane ID（0-31）
        调用: asm("mov.s32 %0, %laneid;")

    @device
    elect_one_sync() -> uint32_t
        用途: 在 warp 内选举一个代表线程（SM90+ 使用 elect.sync）
        调用: asm("elect.sync %%rx|%%px, %1;")  # SM90
        fallback: get_lane_id() == 0            # SM80

【备注】
    - SM90（Hopper）: 硬件支持 elect.sync 指令
    - SM80（Ampere）: 降级为选择 lane 0

---

## TMA（张量内存加速器）与 MBarrier（SM90+）

### 初始化与管理

【函数】
    @device
    fence_barrier_init()
        用途: cluster 级 mbarrier 初始化屏障
        调用: asm("fence.mbarrier_init.release.cluster;")

    @device
    mbarrier_init(mbar_ptr: uint64_t*, arrive_count: uint32_t)
        用途: 初始化 mbarrier，设置到达计数
        调用: asm("mbarrier.init.shared::cta.b64 [%1], %0;")

    @device
    mbarrier_inval(mbar_ptr: uint64_t*)
        用途: 使 mbarrier 失效
        调用: asm("mbarrier.inval.shared::cta.b64 [%0];")

### 等待与到达

【函数】
    @device
    template<bool kWithMultiStages = false>
    mbarrier_wait(mbar_ptr: uint64_t*, phase: uint32_t&, stage_idx: int = 0)
        参数: kWithMultiStages=是否支持多阶段流水线, phase=当前相位, stage_idx=阶段索引
        用途: 等待 mbarrier 达到指定相位
        调用: asm("mbarrier.try_wait.parity.shared::cta.b64 P1, [%0], %1, %2;")
        
        算法:
            wait = kWithMultiStages ? (phase >> stage_idx) & 1 : phase
            loop:
                if mbarrier.try_wait.parity(mbar_ptr, wait):
                    break
            phase ^= kWithMultiStages ? (1 << stage_idx) : 1

    @device
    mbarrier_arrive_and_expect_tx(mbar_ptr: uint64_t*, num_bytes: int)
        用途: 到达 mbarrier 并声明预期传输字节数
        调用: asm("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%1], %0;")

    @device
    mbarrier_arrive(mbar_ptr: uint64_t*)
        用途: 到达 mbarrier（无预期传输）
        调用: asm("mbarrier.arrive.shared::cta.b64 _, [%0];")

### TMA 传输操作

【函数】
    @device
    tma_load_1d(
        smem_ptr: const void*,
        gmem_ptr: const void*,
        mbar_ptr: uint64_t*,
        num_bytes: int,
        evict_first: bool = true
    )
        用途: 1D TMA 异步加载（全局内存 → 共享内存）
        调用: asm("cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes.L2::cache_hint [%0], [%1], %2, [%3], %4;")
        
        配置:
            cache_hint = evict_first ? 0x12f0000000000000 : 0x1000000000000000

    @device
    tma_store_1d(
        smem_ptr: const void*,
        gmem_ptr: const void*,
        num_bytes: int,
        evict_first: bool = true
    )
        用途: 1D TMA 异步存储（共享内存 → 全局内存）
        调用: asm("cp.async.bulk.global.shared::cta.bulk_group.L2::cache_hint [%0], [%1], %2, %3;")
        后续: asm("cp.async.bulk.commit_group;")

    @device
    tma_store_fence()
        用途: TMA 存储屏障（确保存储完成）
        调用: asm("fence.proxy.async.shared::cta;")

    @device
    template<int N>
    tma_store_wait()
        用途: 等待 TMA 存储组完成（至多 N 个未完成组）
        调用: asm("cp.async.bulk.wait_group.read %0;")

【备注】
    - 所有 TMA 指令仅在 SM90（Hopper）架构可用
    - evict_first: 优先驱逐 L2 缓存（适用于一次性数据）


## 原子与同步内存访问（PTX 封装）

### 存储操作

【函数】
    @device
    st_relaxed_sys_global(ptr: const int*, val: int)
        用途: 系统级 relaxed 语义存储（无同步保证）
        调用: asm("st.relaxed.sys.global.s32 [%0], %1;")

    @device
    st_release_sys_global(ptr: const int*, val: int)
        用途: 系统级 release 语义存储（写入对其他设备可见）
        调用: asm("st.release.sys.global.s32 [%0], %1;")

    @device
    st_release_cta(ptr: const int*, val: int)
        用途: CTA 级 release 语义存储
        调用: asm("st.release.cta.s32 [%0], %1;")

### 加载操作

【函数】
    @device
    ld_acquire_sys_global(ptr: const int*) -> int
        用途: 系统级 acquire 语义加载（保证读取最新值）
        调用: asm("ld.acquire.sys.global.s32 %0, [%1];")

    @device
    ld_acquire_sys_global(ptr: const uint64_t*) -> uint64_t
        用途: 系统级 acquire 语义加载（64位）
        调用: asm("ld.acquire.sys.global.u64 %0, [%1];")

    @device
    ld_acquire_global(ptr: const int*) -> int
        用途: GPU 级 acquire 语义加载
        调用: asm("ld.acquire.gpu.global.s32 %0, [%1];")

    @device
    ld_acquire_cta(ptr: const int*) -> int
        用途: CTA 级 acquire 语义加载
        调用: asm("ld.acquire.cta.s32 %0, [%1];")

### 原子操作

【函数】
    @device
    atomic_add_release_sys_global(ptr: const int*, value: int) -> int
        用途: 系统级 release 语义原子加
        调用: asm("atom.add.release.sys.global.s32 %0, [%1], %2;")

    @device
    atomic_add_release_global(ptr: const int*, value: int) -> int
        用途: GPU 级 release 语义原子加
        调用: asm("atom.add.release.gpu.global.s32 %0, [%1], %2;")


## 数学工具函数

【函数】
    @host @device
    template<dtype_t>
    ceil_div(a: dtype_t, b: dtype_t) -> dtype_t
        用途: 向上整除
        算法: (a + b - 1) / b

    @host @device
    template<dtype_t>
    align_up(a: dtype_t, b: dtype_t) -> dtype_t
        用途: 向上对齐到 b 的倍数
        算法: ceil_div(a, b) * b

    @host @device
    template<dtype_t>
    align_down(a: dtype_t, b: dtype_t) -> dtype_t
        用途: 向下对齐到 b 的倍数
        算法: (a / b) * b

    @device
    get_channel_task_range(
        num_tokens: int,
        num_sms: int,
        sm_id: int,
        token_start_idx: int&,
        token_end_idx: int&
    )
        用途: 计算当前 SM 负责的 token 范围（负载均衡）
        算法:
            num_tokens_per_sm = ceil_div(num_tokens, num_sms)
            token_start_idx = min(num_tokens_per_sm * sm_id, num_tokens)
            token_end_idx = min(token_start_idx + num_tokens_per_sm, num_tokens)

---

## 数据打包与解包

【函数】
    @device
    template<dtype_a_t, dtype_b_t>
    pack2(x: dtype_a_t, y: dtype_a_t) -> dtype_b_t
        约束: sizeof(dtype_a_t) * 2 == sizeof(dtype_b_t)
        用途: 将两个值打包为一个更大的类型
        算法:
            packed = dtype_b_t{}
            reinterpret<dtype_a_t*>(packed)[0] = x
            reinterpret<dtype_a_t*>(packed)[1] = y
            return packed

    @device
    template<dtype_a_t, dtype_b_t>
    unpack2(packed: dtype_b_t, x: dtype_a_t&, y: dtype_a_t&)
        约束: sizeof(dtype_a_t) * 2 == sizeof(dtype_b_t)
        用途: 将打包值解包为两个独立值
        算法:
            x = reinterpret<const dtype_a_t*>(packed)[0]
            y = reinterpret<const dtype_a_t*>(packed)[1]

    @device
    template<dtype_t>
    broadcast(ptr: dtype_t&, src_lane_idx: int) -> dtype_t
        约束: sizeof(dtype_t) % sizeof(int) == 0
        用途: warp 内广播数据（从 src_lane_idx 广播到所有 lane）
        算法:
            send_int_values = reinterpret<int*>(ptr)
            for i in range(sizeof(dtype_t) / sizeof(int)):
                recv_int_values[i] = __shfl_sync(0xffffffff, send_int_values[i], src_lane_idx)
            return reinterpret<dtype_t*>(recv_int_values)

---

## FP8 量化工具

【常量】
    kFP8Margin = 1e-4
    kFinfoAmaxE4M3 = 448.0         # FP8 E4M3 最大值
    kFinfoAmaxInvE4M3 = 1 / 448.0

【函数】
    @device
    fast_pow2(x: int) -> float
        约束: -126 <= x <= 127
        用途: 快速计算 2ˣ（通过 IEEE 754 位操作）
        算法:
            bits_x = (x + 127) << 23
            return reinterpret<float>(bits_x)

    @device
    fast_log2_ceil(x: float) -> int
        用途: 快速计算 ⌈log₂(x)⌉
        算法:
            bits_x = reinterpret<uint32_t>(x)
            exp_x = (bits_x >> 23) & 0xff
            man_bits = bits_x & ((1 << 23) - 1)
            return exp_x - 127 + (man_bits != 0)

    @device
    calculate_fp8_scales(
        amax: float,
        scale: float&,
        scale_inv: float&,
        round_scale: bool
    )
        用途: 计算 FP8 量化缩放因子
        算法:
            if round_scale:
                exp_scale_inv = fast_log2_ceil(amax * kFinfoAmaxInvE4M3)
                scale = fast_pow2(-exp_scale_inv)
                scale_inv = fast_pow2(exp_scale_inv)
            else:
                scale_inv = amax * kFinfoAmaxInvE4M3
                scale = kFinfoAmaxE4M3 / amax

    @device
    template<bool kIsUE8M0, typename out_dtype_t>
    extract_required_scale_format(value: float) -> out_dtype_t
        用途: 提取缩放因子为指定格式（UE8M0 或 float）
        算法:
            if kIsUE8M0:
                return static_cast<uint8_t>(reinterpret<uint32_t>(value) >> 23)
            else:
                return value

---

## 多 Rank 同步屏障

【函数】
    @device
    template<int kNumRanks, bool kSyncOnly = false>
    barrier_block(barrier_signal_ptrs: int**, rank: int)
        约束: kNumRanks <= blockDim.x
        用途: 多 rank 间的块级同步屏障（系统级可见性）
        
        算法:
            thread_id = threadIdx.x
            
            # Step 1: 内存屏障（仅非 sync-only 模式）
            if not kSyncOnly:
                memory_fence()
                __syncthreads()
            
            # Step 2: 原子操作发信号
            if thread_id < kNumRanks:
                atomicAdd_system(barrier_signal_ptrs[rank][thread_id], FINISHED_SUM_TAG)
                atomicSub_system(barrier_signal_ptrs[thread_id][rank], FINISHED_SUM_TAG)
            
            # Step 3: 轮询等待（带超时检查）
            start_time = clock64()
            while True:
                value = thread_id < kNumRanks ? ld_volatile_global(barrier_signal_ptrs[rank][thread_id]) : 0
                if __all_sync(0xffffffff, value <= 0):
                    break
                
                if clock64() - start_time > NUM_TIMEOUT_CYCLES and thread_id < kNumRanks:
                    printf("DeepEP timeout check failed: rank = %d, thread = %d, value = %d)\n", rank, thread_id, value)
                    trap()
            
            __syncthreads()

【备注】
    - 使用系统级原子操作保证跨设备可见性
    - 超时检测防止死锁

---

## CTA 级自旋锁

【函数】
    @device
    atomic_cas_cta_acquire(addr: int*, x: int, y: int) -> int
        用途: CTA 级 acquire 语义 CAS（Compare-And-Swap）
        调用: asm("atom.acquire.cta.shared::cta.cas.b32 %0, [%1], %2, %3;")

    @device
    atomic_exch_cta_release(addr: int*, x: int) -> int
        用途: CTA 级 release 语义原子交换
        调用: asm("atom.release.cta.shared::cta.exch.b32 %0, [%1], %2;")

    @device
    acquire_lock(mutex: int*)
        用途: 获取自旋锁
        算法:
            while atomic_cas_cta_acquire(mutex, 0, 1) != 0:
                pass

    @device
    release_lock(mutex: int*)
        用途: 释放自旋锁
        算法:
            atomic_exch_cta_release(mutex, 0)

---

## Warp 级归约

### 归约操作符

【类型】
    ReduceSum<T>: (a, b) -> a + b
    ReduceMax<T>: (a, b) -> max(a, b)
    ReduceMin<T>: (a, b) -> min(a, b)
    ReduceAnd<T>: (a, b) -> a & b
    ReduceOr<T>:  (a, b) -> a | b

### 统一归约接口

【函数】
    @device
    template<int kNumLanesPerGroup, bool kIntergroupReduce, typename T, typename Op>
    warp_reduce(value: T, op: Op) -> T
        约束: kNumLanesPerGroup in {1, 2, 4, 8, 16, 32}
        用途: warp 内归约（支持子 warp 和跨组归约）
        
        算法:
            if kIntergroupReduce:  # 跨组归约（lane 0, 1, 2, ... 各自归约）
                if kNumLanesPerGroup <= 1:  value = op(value, __shfl_xor_sync(0xffffffff, value, 1))
                if kNumLanesPerGroup <= 2:  value = op(value, __shfl_xor_sync(0xffffffff, value, 2))
                if kNumLanesPerGroup <= 4:  value = op(value, __shfl_xor_sync(0xffffffff, value, 4))
                if kNumLanesPerGroup <= 8:  value = op(value, __shfl_xor_sync(0xffffffff, value, 8))
                if kNumLanesPerGroup <= 16: value = op(value, __shfl_xor_sync(0xffffffff, value, 16))
            else:  # 组内归约（每组内部归约到 lane 0）
                if kNumLanesPerGroup >= 32: value = op(value, __shfl_xor_sync(0xffffffff, value, 16))
                if kNumLanesPerGroup >= 16: value = op(value, __shfl_xor_sync(0xffffffff, value, 8))
                if kNumLanesPerGroup >= 8:  value = op(value, __shfl_xor_sync(0xffffffff, value, 4))
                if kNumLanesPerGroup >= 4:  value = op(value, __shfl_xor_sync(0xffffffff, value, 2))
                if kNumLanesPerGroup >= 2:  value = op(value, __shfl_xor_sync(0xffffffff, value, 1))
            return value

### 便捷封装

【函数】
    @device
    template<int kNumLanesPerGroup = 32, bool kIntergroupReduce = false, typename T>
    warp_reduce_sum(value: T) -> T
    warp_reduce_max(value: T) -> T
    warp_reduce_min(value: T) -> T
    warp_reduce_and(value: T) -> T
    warp_reduce_or(value: T) -> T

        用途: 调用 warp_reduce 的便捷包装

【并行模式】
    - kIntergroupReduce=false（默认）: 每个 kNumLanesPerGroup 组内归约到组的 lane 0
    - kIntergroupReduce=true: 所有组的 lane 0/1/2/... 互相归约（用于多组并行）
